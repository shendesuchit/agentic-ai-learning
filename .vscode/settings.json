{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "files.insertFinalNewline": true,
  "editor.tabSize": 4,
  "editor.rulers": [
    88
  ],
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true
  }
}
